---
import '../styles/global.css';
import { getBrandingSettings } from '../lib/db.js';

interface Props {
  title?: string;
  description?: string;
}

const branding = getBrandingSettings();

const { 
  title, 
  description = 'High availability uptime monitoring, distributed probing, and incident response platform.' 
} = Astro.props;

const isImg = (s: string) => s && (s.startsWith('http') || s.startsWith('/') || s.startsWith('data:image'));

// Clean formatted title incorporating the dynamic app name
const pageTitle = title 
  ? (title.toLowerCase().includes(branding.app_name.toLowerCase()) ? title : `${branding.app_name} — ${title}`)
  : `${branding.app_name} — ${branding.app_tagline}`;

const faviconHref = branding.favicon_url && branding.favicon_url.trim() !== ''
  ? branding.favicon_url
  : isImg(branding.logo_icon)
    ? branding.logo_icon
    : `data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>${encodeURIComponent(branding.logo_icon || '🛡️')}</text></svg>`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title id="layout-page-title">{pageTitle}</title>
    <link rel="icon" id="layout-favicon" href={faviconHref} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FAFAFA" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Init dark mode before paint — pisah light/dark (class strategy, localStorage, prefers-color-scheme)
      try {
        const savedTheme = localStorage.getItem('detak_theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = theme;
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) metaTheme.content = theme === 'dark' ? '#09090B' : '#FAFAFA';
        window.addEventListener('detak:theme-changed', (e) => {
          if (metaTheme) metaTheme.content = e.detail === 'dark' ? '#09090B' : '#FAFAFA';
        });
      } catch {}
      // Init language from localStorage (bilingual ID/EN)
      try {
        const saved = localStorage.getItem('app_lang');
        if (saved === 'id' || saved === 'en') document.documentElement.lang = saved;
        else if (navigator.language && navigator.language.toLowerCase().startsWith('en')) document.documentElement.lang = 'en';
      } catch {}
      window.addEventListener('app:locale-changed', (e) => {
        if (e.detail === 'id' || e.detail === 'en') document.documentElement.lang = e.detail;
      });
      // Global live listener for branding updates across tabs
      window.addEventListener('branding_updated', (e) => {
        const b = e.detail;
        if (!b) return;
        const favEl = document.getElementById('layout-favicon');
        if (favEl) {
          if (b.favicon_url && b.favicon_url.trim()) {
            favEl.href = b.favicon_url;
          } else if (b.logo_icon && (b.logo_icon.startsWith('http') || b.logo_icon.startsWith('/') || b.logo_icon.startsWith('data:image'))) {
            favEl.href = b.logo_icon;
          } else {
            favEl.href = 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>' + encodeURIComponent(b.logo_icon || '🛡️') + '</text></svg>';
          }
        }
      });
    </script>
  </body>
</html>

