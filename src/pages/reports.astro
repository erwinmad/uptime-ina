---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportsView from '../components/vue/ReportsView.vue';
import { validateSession } from '../lib/db.js';

const token = Astro.cookies.get('sentinel_session')?.value;
const session = token ? validateSession(token) : null;

if (!session) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Laporan SLA & Kepatuhan Layanan">
  <main>
    <ReportsView client:load currentUser={session.user} />
  </main>
</BaseLayout>
