---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditView from '../components/vue/AuditView.vue';
import { validateSession } from '../lib/db.js';

const token = Astro.cookies.get('sentinel_session')?.value;
const session = token ? validateSession(token) : null;

if (!session) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Audit Trail">
  <main>
    <AuditView client:only="vue" currentUser={session.user} />
  </main>
</BaseLayout>
