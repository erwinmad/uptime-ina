---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusPagesView from '../components/vue/StatusPagesView.vue';
import { validateSession } from '../lib/db.js';

const token = Astro.cookies.get('session')?.value || Astro.cookies.get('sentinel_session')?.value;
const session = token ? validateSession(token) : null;

if (!session) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Manajemen Status Pages">
  <main>
    <StatusPagesView client:only="vue" currentUser={session.user} />
  </main>
</BaseLayout>
