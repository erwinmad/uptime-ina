---
import BaseLayout from '../layouts/BaseLayout.astro';
import IncidentView from '../components/vue/IncidentView.vue';
import { validateSession } from '../lib/db.js';

const token = Astro.cookies.get('sentinel_session')?.value;
const session = token ? validateSession(token) : null;

if (!session) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="Incident Response & Timeline">
  <main>
    <IncidentView client:only="vue" currentUser={session.user} />
  </main>
</BaseLayout>

